[proc,build_ba_cannon](coord $sw){
    loc_add($sw, ba_cannon_wall, 1, wall_diagonal, 10000);
    loc_add(movecoord($sw, 0, 0, 1), ba_cannon_wall, 0, wall_straight, 10000);
    loc_add(movecoord($sw, 0, 0, 2), ba_cannon_wall, 0, wall_straight, 10000);
    loc_add(movecoord($sw, 0, 0, 3), ba_cannon_wall, 0, wall_diagonal, 10000);


    loc_add(movecoord($sw, 4, 0, 0), ba_cannon_wall, 0, wall_diagonal, 10000);
    loc_add(movecoord($sw, 4, 0, 1), ba_cannon_wall, 2, wall_straight, 10000);
    loc_add(movecoord($sw, 4, 0, 2), ba_cannon_wall, 2, wall_straight, 10000);
    loc_add(movecoord($sw, 4, 0, 3), ba_cannon_wall, 1, wall_diagonal, 10000);

    loc_add(movecoord($sw, 1, 0, 3), ba_cannon_wall, 1, wall_straight, 10000);
    loc_add(movecoord($sw, 2, 0, 3), ba_cannon_wall, 1, wall_straight, 10000);
    loc_add(movecoord($sw, 3, 0, 3), ba_cannon_wall, 1, wall_straight, 10000);

    loc_add(movecoord($sw, 1, 0, -1), ba_cannon_wall, 0, wall_straight, 10000);
    loc_add(movecoord($sw, 1, 0, -2), ba_cannon_wall, 0, wall_straight, 10000);

    loc_add(movecoord($sw, 3, 0, -1), ba_cannon_wall, 2, wall_straight, 10000);
    loc_add(movecoord($sw, 3, 0, -2), ba_cannon_wall, 2, wall_straight, 10000);


    loc_add(movecoord($sw, 2, 0, 2), loc_821, 1, centrepiece_straight, 10000);
    
}

[proc,clear_inventory]
if (p_finduid(uid) = true) {
    def_int $slot = 0;
    while($slot < 28){
        inv_delslot(inv, $slot);
        $slot = calc($slot + 1);
    }
}

[proc,get_defender_food]
if(inv_freespace(inv) = 0){
    return;
}
anim(human_pickpocket, 0);
p_arrivedelay();
def_int $i = 0;
while($i < 9){
    if(inv_freespace(inv) > 0){
        inv_add(inv, crackers, 1);
    }
    if(inv_freespace(inv) > 0){
        inv_add(inv, tofu, 1);
    }
    if(inv_freespace(inv) > 0){
        inv_add(inv, worms, 1);
    }
    $i = calc($i + 1);
}

[timer,ba_game]
if(%runners_spawned < %total_runners & %runners_spawned < calc(%initial_runners + %runners_killed)){
    npc_add(0_37_55_36_47, penance_runner, 100);
    %npc_attacking_uid = uid;
    %runners_spawned = calc(%runners_spawned + 1);
}
cleartimer(ba_game);
settimer(ba_game, 11);

[queue,runner_death]
%runners_killed = calc(%runners_killed + 1);

