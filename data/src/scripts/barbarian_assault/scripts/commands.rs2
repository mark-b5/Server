
[debugproc,ba]
if (p_finduid(uid) = true) {
    p_telejump(0_37_55_33_16);

    npc_add(0_37_55_32_17, player_placeholder, 100);
    npc_add(0_37_55_31_18, player_placeholder, 100);
    npc_add(0_37_55_30_17, player_placeholder, 100);
    npc_add(0_37_55_29_16, player_placeholder, 100);



    healenergy(10000);
    ~clear_inventory;
    %runners_killed = 0;
    %initial_runners = 5;
    %total_runners = 6;
    %runners_spawned = 0;

    // Clean up runners
    npc_findall(0_37_55_32_32, penance_runner, 32, 0);
    while (npc_findnext = true) {
        npc_del;
    }

    obj_huntall(0_37_55_36_39, 32, 0);
    while(obj_huntnext=true){
        if(oc_category(obj_type)=runner_foods){
            obj_del;
        }
    }

    inv_add(inv, def_horn, 1);
    settimer(ba_game, 11);

    ~build_ba_map;
}


